# Copy to backend/.env and adjust. Paths are relative to the project root unless absolute.

# --- model files (defaults match scripts/download_models.py defaults) ---
QI_DIFFUSION_MODEL=models/diffusion_models/qwen-image-2.1-UC-Q4_K_M.gguf
QI_TEXT_ENCODER=models/text_encoders/qwen3vl_8b_heretic-Q4_K_M.gguf
QI_TEXT_ENCODER_VISION=models/text_encoders/mmproj-qwen3vl_8b_heretic-f16.gguf
QI_VAE=models/vae/qwen_image_2.1_vae_bf16.safetensors

# --- engine (stable-diffusion.cpp sd-server) ---
QI_ENGINE_BINARY=engine/bin/sd-server
QI_ENGINE_HOST=127.0.0.1
QI_ENGINE_PORT=1234
QI_ENGINE_AUTOSTART=true
QI_ENGINE_FLASH_ATTN=true
# Keep weights in RAM instead of GPU memory (rarely useful on Apple Silicon unified memory)
QI_ENGINE_OFFLOAD_TO_CPU=false
# -1 = physical cores
QI_ENGINE_THREADS=-1
# Anything extra to pass to sd-server, e.g. keep the text encoder on disk to save ~5.4 GB of RAM:
#   QI_ENGINE_EXTRA_ARGS=--params-backend te=disk
QI_ENGINE_EXTRA_ARGS=
QI_ENGINE_STARTUP_TIMEOUT=900

# --- backend ---
QI_OUTPUTS_DIR=outputs
QI_FRONTEND_DIST=frontend/dist
